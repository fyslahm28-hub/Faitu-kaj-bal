<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_prayer_widget_card"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <!-- 1. TOP SECTION: Left (Current Local Time + Short Date & District) | Right (Next Prayer + Live Countdown) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Column: Current Local Time (12-Hour AM/PM) + Date/District Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingRight="6dp">

            <TextClock
                android:id="@+id/widget_live_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:maxLines="1"
                android:textColor="#084B2A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:timeZone="Asia/Dhaka" />

            <TextView
                android:id="@+id/widget_current_time_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:maxLines="1"
                android:text="08:56 AM"
                android:textColor="#084B2A"
                android:textSize="1sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/widget_district_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_prayer_widget_green_pill"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingTop="2.5dp"
                android:paddingRight="10dp"
                android:paddingBottom="2.5dp"
                android:text="Sat, Oct 31 • ঢাকা"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thin Vertical Divider -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="54dp"
            android:background="#2E7D5B"
            android:text="" />

        <!-- Right Column: Next Prayer Badge, Prayer Name, Subtitle & Live Countdown Pill -->
        <LinearLayout
            android:id="@+id/widget_next_prayer_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="6dp">

            <TextView
                android:id="@+id/widget_next_prayer_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_prayer_widget_green_pill"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp"
                android:text="🕌 পরবর্তী নামাজ"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_prayer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="যোহর"
                android:textColor="#084B2A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_current_waqt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="( শুরু হতে বাকি )"
                android:textColor="#145A38"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_prayer_widget_green_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="2dp"
                android:paddingRight="10dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="⏱ 03:24:37"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/widget_countdown_chronometer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:countDown="true"
                    android:textColor="#FFFFFF"
                    android:textSize="1sp"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. MIDDLE SECTION: All 5 Waqts in a Single Compact Horizontal Row with Thin Dividers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_prayer_widget_inner_panel"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/widget_waqt_box_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_prayer_widget_waqt_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_waqt_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="ফজর"
                android:textColor="#084B2A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="05:07 AM"
                android:textColor="#0B3D24"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_badge_fajr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#2E7D5B"
            android:text="" />

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_waqt_box_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_prayer_widget_waqt_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_waqt_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="যোহর"
                android:textColor="#084B2A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="11:45 AM"
                android:textColor="#0B3D24"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_badge_dhuhr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#2E7D5B"
            android:text="" />

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/widget_waqt_box_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_prayer_widget_waqt_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_waqt_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="আসর"
                android:textColor="#084B2A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="03:38 PM"
                android:textColor="#0B3D24"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_badge_asr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#2E7D5B"
            android:text="" />

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/widget_waqt_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_prayer_widget_waqt_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_waqt_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="মাগরিব"
                android:textColor="#084B2A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="05:27 PM"
                android:textColor="#0B3D24"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_badge_maghrib"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#2E7D5B"
            android:text="" />

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/widget_waqt_box_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_prayer_widget_waqt_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_waqt_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="এশা"
                android:textColor="#084B2A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="06:47 PM"
                android:textColor="#0B3D24"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waqt_badge_isha"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. BOTTOM SECTION: Mandatory 3-Language Dates (Bangla, English, Arabic) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/widget_bangla_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="২০ জমাদিউল আউয়াল ১৪৪৮ হিজরি | ১৫ কার্তিক ১৪৩৩ বঙ্গাব্দ | ৩১ অক্টোবর ২০২৬"
            android:textColor="#073B22"
            android:textSize="8sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_english_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="31 October 2026 | 20 Jumada al-Awwal 1448 AH"
                android:textColor="#0B3D24"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#2E7D5B"
                android:text="" />

            <TextView
                android:id="@+id/widget_arabic_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="٣١ أكتوبر ٢٠٢٦ | ٢٠ جمادى الأولى ١٤٤٨ هـ"
                android:textColor="#0B3D24"
                android:textSize="7.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_dates_combined"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_sun_strip_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
