{
  "entities": {
    "AdminRegistryEntry": {
      "description": "Server-verified administrator identity record bound to Firebase Auth UID, email, and admin phone.",
      "properties": {
        "adminId": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "adminPhone": { "type": "string", "required": true },
        "role": { "type": "string", "required": true, "enum": ["SUPER_ADMIN"] },
        "verifiedByAuthToken": { "type": "boolean", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "UserProfile": {
      "description": "Authenticated user profile for Qawmi Madrasa teachers/seekers (Khadim) and Madrasa authorities (Muhtamim) with profile photo and real-time online/last-seen presence.",
      "properties": {
        "userId": { "type": "string", "required": true },
        "fullName": { "type": "string", "required": true },
        "accountType": { "type": "string", "required": true, "enum": ["khadim", "muhtamim"] },
        "district": { "type": "string", "required": true },
        "designation": { "type": "string", "required": true },
        "qualification": { "type": "string", "required": true },
        "experience": { "type": "string", "required": true },
        "preferredDistricts": { "type": "string", "required": true },
        "bio": { "type": "string", "required": true },
        "contactInfo": { "type": "string", "required": true },
        "madrasaName": { "type": "string", "required": true },
        "photoUrl": { "type": "string", "required": false },
        "isOnline": { "type": "boolean", "required": false },
        "lastSeenAt": { "type": "timestamp", "required": false },
        "typingToUserId": { "type": "string", "required": false },
        "typingUpdatedAt": { "type": "timestamp", "required": false },
        "isVerified": { "type": "boolean", "required": true },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "FeedPost": {
      "description": "Public feed item representing either a Madrasa job circular (JOB_CIRCULAR) or a candidate's application post (SEEKER_APPLICATION), supporting Admin Boost and author profile photo.",
      "properties": {
        "authorId": { "type": "string", "required": true },
        "authorName": { "type": "string", "required": true },
        "authorPhotoUrl": { "type": "string", "required": false },
        "postType": { "type": "string", "required": true, "enum": ["JOB_CIRCULAR", "SEEKER_APPLICATION"] },
        "title": { "type": "string", "required": true },
        "district": { "type": "string", "required": true },
        "upazilaOrLocation": { "type": "string", "required": true },
        "designation": { "type": "string", "required": true },
        "qualification": { "type": "string", "required": true },
        "salaryOrExperience": { "type": "string", "required": true },
        "deadlineOrPreferredDistricts": { "type": "string", "required": true },
        "description": { "type": "string", "required": true },
        "contactNumber": { "type": "string", "required": true },
        "madrasaId": { "type": "string", "required": true },
        "isVerifiedMadrasa": { "type": "boolean", "required": true },
        "isBoosted": { "type": "boolean", "required": false },
        "visibility": { "type": "string", "required": true, "enum": ["PUBLIC", "ARCHIVED"] },
        "approvalStatus": { "type": "string", "required": true, "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "MadrasaProfile": {
      "description": "Registered Qawmi Madrasa profile in the directory.",
      "properties": {
        "ownerId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "district": { "type": "string", "required": true },
        "address": { "type": "string", "required": true },
        "establishedYear": { "type": "string", "required": true },
        "highestMarhala": { "type": "string", "required": true },
        "facilities": { "type": "string", "required": true },
        "studentCount": { "type": "string", "required": true },
        "contactPhone": { "type": "string", "required": true },
        "isVerified": { "type": "boolean", "required": true },
        "visibility": { "type": "string", "required": true, "enum": ["PUBLIC", "HIDDEN"] },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "KhedmotSubmission": {
      "description": "Direct job application submitted by a teacher/applicant to a Madrasa circular.",
      "properties": {
        "postId": { "type": "string", "required": true },
        "postTitle": { "type": "string", "required": true },
        "postDesignation": { "type": "string", "required": true },
        "applicantId": { "type": "string", "required": true },
        "applicantName": { "type": "string", "required": true },
        "applicantQualification": { "type": "string", "required": true },
        "applicantExperience": { "type": "string", "required": true },
        "applicantPhone": { "type": "string", "required": true },
        "coverNote": { "type": "string", "required": true },
        "recipientId": { "type": "string", "required": true },
        "status": { "type": "string", "required": true, "enum": ["PENDING", "SHORTLISTED", "ACCEPTED", "REJECTED"] },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "BookmarkItem": {
      "description": "Saved/bookmarked feed post under a user's private bookmarks subcollection.",
      "properties": {
        "userId": { "type": "string", "required": true },
        "postId": { "type": "string", "required": true },
        "postType": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "district": { "type": "string", "required": true },
        "designation": { "type": "string", "required": true },
        "qualification": { "type": "string", "required": true },
        "salaryOrExperience": { "type": "string", "required": true },
        "deadlineOrPreferredDistricts": { "type": "string", "required": true },
        "authorId": { "type": "string", "required": true },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "DirectMessage": {
      "description": "Direct message sent between Madrasa authorities and teachers/applicants.",
      "properties": {
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string", "required": true },
        "senderPhotoUrl": { "type": "string", "required": false },
        "receiverId": { "type": "string", "required": true },
        "receiverName": { "type": "string", "required": true },
        "subject": { "type": "string", "required": true },
        "body": { "type": "string", "required": true },
        "isRead": { "type": "boolean", "required": true },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "AppNotification": {
      "description": "In-app and push notification item for a specific recipient userId or ALL_USERS community feed.",
      "properties": {
        "recipientId": { "type": "string", "required": true },
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "message": { "type": "string", "required": true },
        "type": { "type": "string", "required": true, "enum": ["APPLICATION", "MESSAGE", "VERIFICATION", "NEW_CIRCULAR", "NEW_APPLICATION", "ANNOUNCEMENT", "BOOST"] },
        "referenceId": { "type": "string", "required": true },
        "isRead": { "type": "boolean", "required": true },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "NotificationReadReceipt": {
      "description": "Per-user read receipt for notifications stored under /users/{userId}/notification_reads/{notificationId}.",
      "properties": {
        "userId": { "type": "string", "required": true },
        "notificationId": { "type": "string", "required": true },
        "readAt": { "type": "timestamp", "required": true }
      }
    },
    "TelegramNotificationLog": {
      "description": "Server-backed Telegram alert queue and audit log for platform events and admin actions.",
      "properties": {
        "eventType": { "type": "string", "required": true, "enum": ["NEW_CIRCULAR", "NEW_APPLICATION", "KHEDMOT_SUBMISSION", "NEW_MADRASA", "ADMIN_ANNOUNCEMENT", "ADMIN_VERIFICATION", "ADMIN_SECURITY"] },
        "title": { "type": "string", "required": true },
        "message": { "type": "string", "required": true },
        "actorId": { "type": "string", "required": true },
        "actorName": { "type": "string", "required": true },
        "targetPhone": { "type": "string", "required": true },
        "referenceId": { "type": "string", "required": true },
        "deliveryStatus": { "type": "string", "required": true, "enum": ["DELIVERED", "QUEUED", "FAILED"] },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    }
  },
  "collections": [
    {
      "path": "/admins/{adminId}",
      "entity": "AdminRegistryEntry",
      "access": "Only verified admins (authenticated via Firebase Auth token / Custom Claims) can read or sync their own registry entry."
    },
    {
      "path": "/users/{userId}",
      "entity": "UserProfile",
      "access": "Authenticated users can read profiles; only the owner can create/update their own profile (admins can toggle isVerified)."
    },
    {
      "path": "/users/{userId}/bookmarks/{bookmarkId}",
      "entity": "BookmarkItem",
      "access": "Strict owner-only read, create, and delete."
    },
    {
      "path": "/users/{userId}/notification_reads/{notificationId}",
      "entity": "NotificationReadReceipt",
      "access": "Strict owner-only read, create, update, and delete."
    },
    {
      "path": "/feed_posts/{postId}",
      "entity": "FeedPost",
      "access": "Authenticated users can read public posts and create posts with their own authorId; authors can update/delete their own posts; admins can moderate, verify, and boost."
    },
    {
      "path": "/madrasas/{madrasaId}",
      "entity": "MadrasaProfile",
      "access": "Authenticated users can read public madrasas and register their own madrasa; owners can update; admins can toggle isVerified."
    },
    {
      "path": "/khedmot_submissions/{submissionId}",
      "entity": "KhedmotSubmission",
      "access": "Authenticated applicants can create submissions; only the applicant, recipient madrasa author, or admin can read; recipient or admin can update status."
    },
    {
      "path": "/messages/{messageId}",
      "entity": "DirectMessage",
      "access": "Authenticated users can create messages where senderId == auth.uid; only sender or receiver can read; receiver can mark isRead."
    },
    {
      "path": "/notifications/{notificationId}",
      "entity": "AppNotification",
      "access": "Authenticated users can create notifications where senderId == auth.uid; recipient or ALL_USERS can read; recipient can mark isRead; only admin can create ANNOUNCEMENT or BOOST notifications."
    },
    {
      "path": "/telegram_notifications/{logId}",
      "entity": "TelegramNotificationLog",
      "access": "Authenticated users can enqueue event notifications for their own actions; only verified admins can read, list, or delete logs."
    }
  ]
}
