# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below and keep this file uncommitted when using Secrets Gradle Plugin.
GEMINI_API_KEY=GEMINI_API_KEY_DEFAULT_VALUE

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Used for real-time Admin Telegram Notifications
# to @Q_kormosongsthan_Bangladesh.
# Configure these securely in the AI Studio Secrets Panel (never hardcode in frontend code).
TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN_DEFAULT_VALUE
TELEGRAM_CHAT_ID=@Q_kormosongsthan_Bangladesh
